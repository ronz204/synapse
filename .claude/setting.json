{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Bash(bun install)",
      "Bash(bun run *)",
      "Bash(bunx *)",
      "Bash(php -m)",
      "Bash(php -v)",
      "Bash(php --ini)",
      "Bash(php -i)",
      "Bash(curl *)",
      "Bash(php artisan *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(powershell *)",
      "Bash(docker compose *)",
      "Bash(vendor/bin/pint --format agent)",
      "Bash(vendor/bin/pint --test --format agent)",
      "Bash(vendor/bin/pint --dirty --format agent)",
      "Bash(php -d memory_limit=-1 vendor/bin/phpstan analyse --no-progress)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push *)",
      "Bash(git pull *)"
    ]
  }
}